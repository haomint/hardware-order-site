NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# 仅在后端只能由可信反向代理访问、且代理重写转发地址时设为 true。
TRUST_PROXY=false

# 生产环境填写 HTTPS 站点来源，不带路径或尾斜杠。
SITE_ORIGIN=http://localhost:5173
# 仅开发环境读取。多个来源用逗号分隔，支持不同端口或手机联调的局域网来源。
DEV_ALLOWED_ORIGINS=

# 相对路径以 server 目录为基准。
DATABASE_PATH=data/hardware-order.sqlite
UPLOAD_DIR=uploads

# 店铺三项资料只在数据库尚未初始化时使用。日常修改通过后台保存。
SHOP_NAME=威马五金
SHOP_PHONE=
SHOP_WECHAT_CONTACT_TEXT=

# 企业微信自建应用。全部填写后启用新订单提醒。
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_USER_ID=

# 邮件备用提醒。填写 SMTP 主机、账号、授权码及收件邮箱后启用。
# 465 默认 tls，其他端口默认 starttls。发件邮箱留空时用 SMTP 账号。
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=465
NOTIFICATION_SMTP_SECURITY=
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

# 待联系订单再次提醒。夜间时段用北京时间，起止相同表示全天可发送。
ORDER_TIMEOUT_MINUTES=120
ORDER_TIMEOUT_QUIET_START=21:00
ORDER_TIMEOUT_QUIET_END=08:00

# 首次设置或重置账号时，由命令环境临时提供，不需要写入 .env。
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
