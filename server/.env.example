NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# 仅在后端只能由可信反向代理访问、且代理重写转发地址时设为 true。
TRUST_PROXY=false

# 生产环境填写 HTTPS 站点来源，不带路径或尾斜杠。
SITE_ORIGIN=http://localhost:5173
# 仅开发环境读取。多个来源用逗号分隔，支持不同端口或手机联调的局域网来源。
DEV_ALLOWED_ORIGINS=

# 相对路径以 server 目录为基准。
DATABASE_PATH=data/hardware-order.sqlite
UPLOAD_DIR=uploads

SHOP_NAME=威马五金
SHOP_PHONE=
SHOP_WECHAT_CONTACT_TEXT=

# 企业微信自建应用。全部填写后启用新订单提醒。
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_USER_ID=

# 首次设置或重置账号时，由命令环境临时提供，不需要写入 .env。
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
